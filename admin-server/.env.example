# Copy this file to .env in the same folder and fill in real values.
# .env is already gitignored — never commit real secrets.

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Any password for the local Postgres container (not exposed outside Docker).
PGPASSWORD=

# https://github.com/RockHataBar/RockHataBar.github.io.git
GITHUB_REPO_URL=https://github.com/RockHataBar/RockHataBar.github.io.git

# GitHub → Settings → Developer settings → Personal access tokens →
# Fine-grained token, scoped to this one repo, Contents: Read and write.
GITHUB_TOKEN=

GIT_BRANCH=main
GIT_AUTHOR_NAME=ROCK HATA Admin Panel
GIT_AUTHOR_EMAIL=admin-panel@rockhata.local

# Optional — only needed if you want the panel reachable from outside the
# bar's wifi while it's running. From the Cloudflare Zero Trust dashboard:
# Networks -> Tunnels -> Create a tunnel -> copy the token shown there.
CLOUDFLARE_TUNNEL_TOKEN=
